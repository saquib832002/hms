# LOCAL DEVELOPMENT ONLY — dummy values, dummy data.
# Real credentials never live in git. See CLAUDE.md rule 6.
NODE_ENV=development
PORT=3000

# TWO connection strings, and they are not interchangeable.
#
# The API connects as a plain, non-superuser role. This matters more than it
# looks: a superuser BYPASSES Row-Level Security entirely — `FORCE ROW LEVEL
# SECURITY` does not stop them — so pointing the running app at an owner or
# postgres account silently turns off tenant isolation. Every hospital would
# see every other hospital's patients, and nothing in the app would say so.
#
# `npm run db:rls` creates the hms_app role and syncs its password to whatever
# this says, so pick the password here first.
DATABASE_URL="postgresql://hms_app:PASSWORD@127.0.0.1:5432/hms_db"

# The database owner. Used only by migrations, `npm run db:rls` and the seed —
# the things that must create tables, roles and policies. `db:rls` refuses to
# start without it, because applying policies as the role they restrict is the
# one way to produce a database that looks protected and is not.
DATABASE_URL_ADMIN="postgresql://hms_owner:PASSWORD@127.0.0.1:5432/hms_db"

# Dev-only secrets. Generate real ones with: openssl rand -hex 32
JWT_ACCESS_SECRET="<openssl rand -hex 32>"
JWT_REFRESH_SECRET="<openssl rand -hex 32>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# NOTE: there is no timezone setting here, and that is deliberate.
#
# Every timestamp is stored in UTC. What "today" contains, which appointment
# slots exist, and which month a payment falls in are all decided by the
# *hospital's* timezone — `Tenant.timezone`, set per hospital from
# Admin → Clinic Settings and resolved on every request.
#
# A process-wide value would be wrong the moment a second hospital in another
# zone shares the deployment, which is the whole point of multi-tenancy.
# Leave the server and Postgres on UTC.

# Comma-separated origins allowed to call the API (web dev server, Expo).
CORS_ORIGINS="http://localhost:3001,http://localhost:19006"
