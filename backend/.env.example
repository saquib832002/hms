# LOCAL DEVELOPMENT ONLY — dummy values, dummy data.
# Real credentials never live in git. See CLAUDE.md rule 6.
NODE_ENV=development
PORT=3000

# TWO connection strings, and they are not interchangeable.
#
# The API connects as a plain, non-superuser role. This matters more than it
# looks: a superuser BYPASSES Row-Level Security entirely — `FORCE ROW LEVEL
# SECURITY` does not stop them — so pointing the running app at an owner or
# postgres account silently turns off tenant isolation. Every hospital would
# see every other hospital's patients, and nothing in the app would say so.
#
# `npm run db:rls` creates the hms_app role and syncs its password to whatever
# this says, so pick the password here first.
DATABASE_URL="postgresql://hms_app:PASSWORD@127.0.0.1:5432/hms_db"

# The database owner. Used only by migrations, `npm run db:rls` and the seed —
# the things that must create tables, roles and policies. `db:rls` refuses to
# start without it, because applying policies as the role they restrict is the
# one way to produce a database that looks protected and is not.
DATABASE_URL_ADMIN="postgresql://hms_owner:PASSWORD@127.0.0.1:5432/hms_db"

# Dev-only secrets. Generate real ones with: openssl rand -hex 32
JWT_ACCESS_SECRET="<openssl rand -hex 32>"
JWT_REFRESH_SECRET="<openssl rand -hex 32>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# NOTE: there is no timezone setting here, and that is deliberate.
#
# Every timestamp is stored in UTC. What "today" contains, which appointment
# slots exist, and which month a payment falls in are all decided by the
# *hospital's* timezone — `Tenant.timezone`, set per hospital from
# Admin → Clinic Settings and resolved on every request.
#
# A process-wide value would be wrong the moment a second hospital in another
# zone shares the deployment, which is the whole point of multi-tenancy.
# Leave the server and Postgres on UTC.

# Comma-separated origins allowed to call the API (web dev server, Expo).
CORS_ORIGINS="http://localhost:3001,http://localhost:19006"

# ── Email, and therefore self-service password reset ─────────────────────────
#
# MAIL_TRANSPORT decides what happens, and there are exactly three outcomes:
#
#   smtp   Messages are delivered. Both login screens offer "Forgot your
#          password?" — `GET /health` reports `passwordResetAvailable: true`.
#   log    Messages are written to the server log, link included, and NOT
#          delivered. Right for development; the boot log says so loudly, and
#          the clients still hide the link, because a form that says "check
#          your email" when nothing was sent is worse than no form.
#   unset  Nothing is sent and the link is not offered. Password reset then
#          means an administrator (Admin → Users) or, for an administrator
#          themselves, the vendor under a break-glass grant.
#
# `npm run password:reset -- <email>` works in all three and needs none of
# this — it is the recovery path for a deployment where mail is the broken
# thing.
MAIL_TRANSPORT="log"

# Deliberately not a plausible-looking default. A real relay refuses this, which
# is the correct outcome for a deployment that forgot to set it — a default that
# looked deliverable is one somebody ships.
MAIL_FROM="no-reply@localhost"

SMTP_HOST=""
SMTP_PORT=587
# `true` only for implicit TLS on 465. On 587 the connection starts plain and
# upgrades with STARTTLS, which nodemailer does by default — setting this there
# produces a hang rather than an error, which is the least diagnosable failure
# available. Compared as the string "true", so writing `false` means false.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Where the reset link points. Configured rather than taken from the request's
# Host header, and that is the point: a link built from a header is one an
# attacker aims at their own server by sending `Host: evil.example`, and the
# victim clicking it hands over a live token.
WEB_URL="http://localhost:3001"

# Long enough to walk to a computer, short enough that a link left in a shared
# clinic mailbox is not a standing key.
PASSWORD_RESET_TTL_MINUTES=30

# ── Vendor console reset ─────────────────────────────────────────────────────
#
# A PlatformUser credential can open a break-glass grant against ANY hospital on
# this deployment, so emailed recovery makes the platform's security as strong
# as one mailbox. Three things are what make it defensible, and all three are
# here rather than buried:
#
#  - a shorter link (15 minutes, not 30),
#  - every other console account is emailed on the request AND on completion,
#    so a takeover through one mailbox cannot be silent,
#  - break-glass is refused for an hour afterwards. The console keeps working;
#    reaching *inside* a hospital waits.
#
# The third is the only one that actually interrupts the attack, and it is the
# one with a real cost: an engineer who has just reset their password at 3am
# waits, or asks a colleague to open the grant. Set it to 0 if that trade is
# wrong for your operation — it is a decision, not a law. It does NOT apply to
# `npm run platform:user`, which already needs the database owner's credentials.
PLATFORM_RESET_TTL_MINUTES=15
PLATFORM_RESET_GRANT_COOLDOWN_MINUTES=60
